{
	"name": "ABS_DynamicFile",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_AzureBlobStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"Foldername": {
				"type": "string"
			},
			"Filename": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@dataset().Filename",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().Foldername",
					"type": "Expression"
				},
				"container": "dataset"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "emp_id",
				"type": "String"
			},
			{
				"name": "Emp_name",
				"type": "String"
			},
			{
				"name": "Skill",
				"type": "String"
			}
		]
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}